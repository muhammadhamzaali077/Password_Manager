# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored so the secrets stay local.

# --- Database (Prisma + Next.js) ---
# Neon Postgres connection string. Get it from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Agent (Python serverless function) ---
# OpenAI API key for the gpt-4o-mini chat completions calls.
OPENAI_API_KEY=sk-...

# --- Optional ---
# Locks the agent's CORS to this origin. Defaults to "*" if unset.
ALLOWED_ORIGIN=http://localhost:3000
