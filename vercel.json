{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd frontend && pnpm install --frozen-lockfile=false && pnpm prisma generate && pnpm build",
  "installCommand": "echo 'install handled in buildCommand'",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "functions": {
    "backend/src/agent/main.py": {
      "runtime": "@vercel/python@4.3.0",
      "memory": 512,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/agent/:path*",
      "destination": "/backend/src/agent/main.py"
    }
  ]
}
