{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://password-manager-health-check.local/contracts/agent-score.schema.json",
  "title": "AgentScore",
  "description": "Contract for POST /agent/score on the FastAPI agent.",
  "type": "object",
  "definitions": {
    "Band": {
      "type": "string",
      "enum": ["HEALTHY", "OKAY", "CRITICAL"]
    },
    "Recommendation": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable catalogue identifier (UPPER_SNAKE_CASE)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Short, encouraging, user-facing fix description."
        }
      }
    },
    "Request": {
      "type": "object",
      "required": ["password_count", "oldest_password_age_months"],
      "additionalProperties": false,
      "properties": {
        "password_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "oldest_password_age_months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      }
    },
    "Response": {
      "type": "object",
      "required": ["score", "band", "recommendations", "message"],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "band": { "$ref": "#/definitions/Band" },
        "recommendations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": { "$ref": "#/definitions/Recommendation" }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Encouraging, user-safe wrapper text the chat shows above the card."
        }
      }
    },
    "Error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_INPUT",
            "AGENT_TIMEOUT",
            "AGENT_FORMAT_ERROR",
            "RATE_LIMITED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        }
      }
    }
  }
}
